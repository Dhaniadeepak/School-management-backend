NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/school_app
TIMEZONE=Asia/Kolkata

# Use long random strings in production (openssl rand -hex 32)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
OTP_SECRET=dev-otp-secret-change-me-please
FILE_URL_SECRET=dev-file-secret-change-me-please

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS_STAFF=7
REFRESH_TOKEN_TTL_DAYS_PARENT=90

# Comma-separated list of portal origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Used to build signed download links for homework files and receipts
PUBLIC_API_URL=http://localhost:4000
UPLOAD_DIR=./uploads

# SMS: "console" prints OTPs to the server log; "msg91" sends real SMS (DLT template needed)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Razorpay (leave empty to disable). Webhook URL: <PUBLIC_API_URL>/api/v1/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Development only: lets the parent portal complete a fake payment without a gateway
PAYMENTS_MOCK=true

# Firebase Cloud Messaging: path to a service-account JSON file, or the JSON itself (leave empty to disable push)
FIREBASE_SERVICE_ACCOUNT=
